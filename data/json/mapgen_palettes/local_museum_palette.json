[
  {
    "type": "palette",
    "id": "local_museum_palette_common",
    "parameters": {
      "original_wall_type": {
        "type": "ter_str_id",
        "default": { "distribution": [ [ "t_brick_wall", 2 ], [ "t_rock_wall", 1 ], [ "t_wall_wood", 1 ] ] }
      },
      "refurb_wall_type": {
        "type": "ter_str_id",
        "default": { "distribution": [ [ "t_wall", 2 ], [ "t_wall_r", 1 ], [ "t_wall_w", 1 ], [ "t_wall_brown", 1 ] ] }
      },
      "carpet_type": {
        "type": "ter_str_id",
        "default": { "distribution": [ [ "t_carpet_red", 1 ], [ "t_carpet_green", 1 ], [ "t_carpet_purple", 1 ] ] }
      }
    },
    "terrain": {
      "#": { "param": "original_wall_type", "fallback": "t_brick_wall" },
      "'": { "param": "refurb_wall_type", "fallback": "t_brick_wall" },
      "^": { "param": "carpet_type", "fallback": "t_carpet_red" },
      "|": "t_floor",
      "/": "t_linoleum_white",
      "-": "t_floor_noroof",
      "$": "t_railing",
      ",": "t_privacy_fence",
      "s": "t_gutter_downspout",
      "S": "t_gutter_drop",
      "_": "t_gutter",
      ">": "t_wood_stairs_down",
      "<": "t_wood_stairs_up",
      "D": [ [ "t_door_c", 3 ], [ "t_door_locked", 6 ] ],
      "d": [ [ "t_door_o", 3 ], [ "t_door_c", 1 ] ],
      "t": [ [ "t_window_frame", 2 ], [ "t_curtains_alarm", 8 ], [ "t_window_domestic_alarm", 6 ] ],
      ".": "t_region_groundcover",
      "+": "t_shingle_flat_roof",
      "=": "t_wood_roof",
      "o": "t_column"
    }
  }
]
